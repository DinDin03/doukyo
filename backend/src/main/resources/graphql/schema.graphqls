# This is the GraphQL SCHEMA — the contract between client and server.
# Spring for GraphQL auto-loads every *.graphqls file under resources/graphql/.
#
# GraphQL is schema-first and strongly typed: the client can only ask for fields
# declared here, and the server must return exactly these shapes. The schema is the
# single source of truth both sides code against (the mobile app will even generate
# TypeScript types from it).

type Query {
    # `String!` — the `!` means non-null: a successful ping ALWAYS returns a string.
    ping: String!
    greeting: String!
    hello: String!

    # --- Milestone 1a: Users ---
    # Every user. `[User!]!` = a non-null list of non-null Users:
    # the list itself is never null, and no element inside it is ever null.
    users: [User!]!

    # --- Households ---
    myHouseholds: [Household!]!        # households the current user belongs to
    household(id: ID!): Household      # one by id — null if it doesn't exist OR you're not a member

    # --- Chat ---
    # Newest first. Omit `before` for the latest page; pass the oldest id you hold
    # to page further back (keyset pagination).
    messages(householdId: ID!, before: ID, limit: Int): [Message!]!
    # Oldest first. Everything after `after` — the reconnect backfill.
    messagesSince(householdId: ID!, after: ID!): [Message!]!
    unreadMessageCount(householdId: ID!): Int!

    # --- Auth ---
    me: User!                          # the currently signed-in user (errors if not)
}

# The Mutation root type holds operations that CHANGE data.
# Convention: queries read, mutations write.
type Mutation {
    # Create a user; returns the created row (including its DB-assigned id).
    createUser(name: String!, email: String!): User!

    # Creates a household AND makes the caller its first member — one step, not two.
    createHousehold(name: String!): Household!
    # Joins the household matching the invite code as the current user.
    joinHousehold(code: String!): Household!

    # --- Auth ---
    signUp(name: String!, email: String!, password: String!): AuthPayload!
    signIn(email: String!, password: String!): AuthPayload!
    refresh(refreshToken: String!): AuthPayload!
    # idToken = the Google-signed ID token the app receives after a Google
    # sign-in prompt. We verify it server-side; never trusted as-is.
    googleSignIn(idToken: String!): AuthPayload!
    # Revokes the refresh token server-side. Always returns true — an unknown or
    # already-revoked token is not an error.
    signOut(refreshToken: String!): Boolean!

    # --- Chat ---
    # `clientId` is generated by the sender. Sending the same one twice returns the
    # original message instead of duplicating it.
    sendMessage(householdId: ID!, body: String!, clientId: String!): Message!
    # Moves the read bookmark forward (never backwards). Returns the new position.
    markMessagesRead(householdId: ID!, messageId: ID!): Int!
}

# A person. For now this mirrors the `users` table / User entity directly.
type User {
    id: ID!          # ID serializes as a String; maps from the Long primary key
    name: String!
    email: String!
}

# A shared house. `members` is resolved on demand from the memberships join table.
type Household {
    id: ID!
    name: String!
    inviteCode: String!       # share this so others can joinHousehold(code:)
    createdAt: String!        # timestamp, serialized as an ISO-8601 string
    members: [User!]!         # the users in this household (via memberships)
}

# Returned by every auth mutation: the tokens plus the signed-in user.
type AuthPayload {
    accessToken: String!      # short-lived JWT — send as `Authorization: Bearer <token>`
    refreshToken: String!     # long-lived; exchange for a new access token via refresh()
    user: User!
}

# --- Chat ---
# One thread per household. Being in the household IS being in the chat.
type Message {
    id: ID!
    body: String!
    clientId: String!         # the sender's own id — used to reconcile optimistic sends
    createdAt: String!
    sender: MessageAuthor!
}

type MessageAuthor {
    id: ID!
    name: String!
}

# Live delivery. Only messages for the given household reach this stream.
type Subscription {
    messageAdded(householdId: ID!): Message!
}
