# This is the GraphQL SCHEMA — the contract between client and server.
# Spring for GraphQL auto-loads every *.graphqls file under resources/graphql/.
#
# GraphQL is schema-first and strongly typed: the client can only ask for fields
# declared here, and the server must return exactly these shapes. The schema is the
# single source of truth both sides code against (the mobile app will even generate
# TypeScript types from it).

type Query {
    # `String!` — the `!` means non-null: a successful ping ALWAYS returns a string.
    ping: String!
    greeting: String!
    hello: String!

    # --- Milestone 1a: Users ---
    # Every user. `[User!]!` = a non-null list of non-null Users:
    # the list itself is never null, and no element inside it is ever null.
    users: [User!]!

    # --- Households ---
    households: [Household!]!          # all households
    household(id: ID!): Household      # one by id, or null if not found
}

# The Mutation root type holds operations that CHANGE data.
# Convention: queries read, mutations write.
type Mutation {
    # Create a user; returns the created row (including its DB-assigned id).
    createUser(name: String!, email: String!): User!

    createHousehold(name: String!): Household!
    # Add an existing user to a household; returns the updated household.
    addMember(householdId: ID!, userId: ID!): Household!
}

# A person. For now this mirrors the `users` table / User entity directly.
type User {
    id: ID!          # ID serializes as a String; maps from the Long primary key
    name: String!
    email: String!
}

# A shared house. `members` is resolved on demand from the memberships join table.
type Household {
    id: ID!
    name: String!
    createdAt: String!        # timestamp, serialized as an ISO-8601 string
    members: [User!]!         # the users in this household (via memberships)
}
